{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "node vocabulary-planning/build_vercel_preview.mjs",
  "installCommand": "",
  "outputDirectory": "vocabulary-planning/deploy/demo-site",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"},
        {"key": "Cache-Control", "value": "no-store"}
      ]
    }
  ]
}
